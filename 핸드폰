<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>juju와의 메시지</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #f0f0f0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        /* 스마트폰 프레임 디자인 */
        .iphone-frame {
            width: 100%;
            max-width: 414px;
            height: 100vh;
            max-height: 896px;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            position: relative;
            overflow: hidden;
        }
        @media (min-width: 480px) {
            .iphone-frame {
                height: 844px;
                border-radius: 40px;
                border: 10px solid #222;
            }
        }
        /* 상단 네비게이션 (상대방 프로필) */
        .chat-header {
            padding: 15px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            border-bottom: 1px solid #e5e5ea;
            background: rgba(255,255,255,0.9);
        }
        .profile-img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #cbd5e1;
            margin-bottom: 5px;
            background-image: url('https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150'); /* 임시 프로필 이미지 */
            background-size: cover;
        }
        .profile-name {
            font-size: 15px;
            font-weight: 600;
            color: #1c1c1e;
        }
        /* 메시지 목록 영역 */
        .chat-body {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
            background-color: #fff;
        }
        .date-label {
            text-align: center;
            font-size: 11px;
            color: #8e8e93;
            margin: 10px 0;
        }
        .message {
            max-width: 70%;
            padding: 10px 14px;
            border-radius: 18px;
            font-size: 15px;
            line-height: 1.4;
            word-break: break-all;
        }
        /* 상대방 메시지 (iMessage 회색) */
        .message.received {
            background-color: #e9e9eb;
            color: #000;
            align-self: flex-start;
            border-bottom-left-radius: 4px;
        }
        /* 내 메시지 (iMessage 파란색) */
        .message.sent {
            background-color: #007aff;
            color: #fff;
            align-self: flex-end;
            border-bottom-right-radius: 4px;
        }
        /* 사진 메시지 스타일 */
        .message img {
            width: 100%;
            border-radius: 12px;
            margin-top: 5px;
        }
        /* 하단 입력창 영역 */
        .chat-footer {
            display: flex;
            align-items: center;
            padding: 10px 15px;
            background-color: #f6f6f6;
            border-top: 1px solid #e5e5ea;
        }
        .chat-footer input {
            flex: 1;
            padding: 10px 15px;
            border-radius: 20px;
            border: 1px solid #c7c7cc;
            outline: none;
            font-size: 15px;
            background: #fff;
        }
        .send-btn {
            background-color: #007aff;
            color: white;
            border: none;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            margin-left: 8px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>

    <div class="iphone-frame">
        <!-- 상단 프로필 헤더 -->
        <div class="chat-header">
            <div class="profile-img"></div>
            <div class="profile-name">juju 〉</div>
        </div>

        <!-- 대화 내용 공간 -->
        <div class="chat-body" id="chatBody">
            <div class="date-label">2023년 7월 28일 15:20</div>
            
            <div class="message received">
                날씨가 너무 덥다
            </div>
            <div class="message received">
                나는 바다 놀러왔지롱 🕶️
            </div>
            <div class="message sent">
                갑자기? 오늘??
            </div>
            <div class="message sent">
                여행온거야?
            </div>
        </div>

        <!-- 메시지 전송 바 -->
        <div class="chat-footer">
            <input type="text" id="userInput" placeholder="iMessage" onkeypress="if(event.key==='Enter')sendMessage()">
            <button class="send-btn" onclick="sendMessage()">↑</button>
        </div>
    </div>

    <script>
        function sendMessage() {
            const input = document.getElementById('userInput');
            const chatBody = document.getElementById('chatBody');
            
            if (!input.value.trim()) return;

            // 내가 보낸 메시지 생성
            const msgDiv = document.createElement('div');
            msgDiv.className = 'message sent';
            msgDiv.textContent = input.value;
            chatBody.appendChild(msgDiv);

            input.value = '';
            chatBody.scrollTop = chatBody.scrollHeight;
        }
    </script>
</body>
</html>
